{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "genaicommunity-api",
  "main": "index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "https://genaicommunity.ai/api/v1/*", "zone_name": "genaicommunity.ai" },
    { "pattern": "https://genaicommunity.ai/v1/*", "zone_name": "genaicommunity.ai" }
  ],
  "vars": { "SITE_URL": "https://genaicommunity.ai" },
  "services": [{ "binding": "ADMISSIONS", "service": "genaicommunity-admissions", "entrypoint": "AdmissionsGateway" }],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "genaicommunity-api-staging",
      "routes": [
        { "pattern": "https://staging.genaicommunity.ai/api/v1/*", "zone_name": "genaicommunity.ai" },
        { "pattern": "https://staging.genaicommunity.ai/v1/*", "zone_name": "genaicommunity.ai" }
      ],
      "vars": { "SITE_URL": "https://staging.genaicommunity.ai" },
      "services": [{ "binding": "ADMISSIONS", "service": "genaicommunity-admissions-staging", "entrypoint": "AdmissionsGateway" }]
    }
  }
}
