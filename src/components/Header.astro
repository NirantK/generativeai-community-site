---
const whatsappUrl = '/apply';
const navItems = [
  { label: 'HOME', href: '/' },
  { label: 'PEOPLE', href: '/people/' },
  { label: 'EVENTS', href: '/events' },
  { label: 'MODELS', href: '/models' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="border-b border-outline-variant bg-background sticky top-0 z-10">
  <div class="mx-auto max-w-3xl flex items-center justify-between px-margin-mobile md:px-margin-desktop min-h-tap gap-2 md:gap-gutter">
    <a
      href="/"
      class="font-mono text-label-caps uppercase text-on-surface min-h-tap inline-flex items-center"
      aria-label="GenerativeAI Community — back to home"
    >
      <img src="/brand/logo.svg" alt="" width="28" height="28" class="mr-2 shrink-0" />
      <span class="hidden sm:inline">GENERATIVEAI_COMMUNITY</span><span class="sm:hidden">GENAI</span>
    </a>
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {navItems.map((it) => {
        const normalised = it.href.replace(/\/$/, '') || '/';
        const active = (it.href === '/' && path === '/') || (it.href !== '/' && (path === normalised || path.startsWith(normalised + '/')));
        return (
          <a
            href={it.href}
            class:list={[
              'font-mono text-label-caps uppercase px-3 min-h-tap inline-flex items-center transition-colors',
              active ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {it.label}
          </a>
        );
      })}
    </nav>
    <a
      href={whatsappUrl}
      rel="noopener"
      class="font-mono text-label-caps uppercase border border-outline-variant px-3 min-h-tap inline-flex items-center text-on-surface hover:border-primary hover:text-primary transition-colors"
    >
      Apply to Join
    </a>
  </div>
</header>
