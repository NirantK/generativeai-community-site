---
const whatsappUrl = 'https://nas.io/the-generativeai-group';
---
<header class="border-b border-outline-variant bg-background sticky top-0 z-10">
  <div class="mx-auto max-w-3xl flex items-center justify-between px-margin-mobile md:px-margin-desktop min-h-tap gap-gutter">
    <a
      href="/"
      class="font-mono text-label-caps uppercase text-on-surface min-h-tap inline-flex items-center"
    >
      GENAI_COMMUNITY
    </a>
    <a
      href={whatsappUrl}
      rel="noopener"
      class="font-mono text-label-caps uppercase border border-outline-variant px-3 min-h-tap inline-flex items-center text-on-surface hover:border-primary hover:text-primary transition-colors"
    >
      JOIN_WHATSAPP
    </a>
  </div>
</header>
