---
const items = [
  { label: 'HOME', href: '/' },
  { label: 'PEOPLE', href: '/people' },
  { label: 'DEMOS', href: '/deephackdemos' },
  { label: 'EVENTS', href: '/demoday102023' },
  { label: 'JOIN', href: 'https://nas.io/the-generativeai-group' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav
  class="fixed bottom-0 inset-x-0 border-t border-outline-variant bg-background md:hidden"
  aria-label="Primary"
>
  <ul class="grid grid-cols-5">
    {items.map((it) => {
      const normalised = it.href.replace(/\/$/, '') || '/';
      const active = it.href.startsWith('/') && (
        (it.href === '/' && path === '/') ||
        (it.href !== '/' && (path === normalised || path.startsWith(normalised + '/')))
      );
      return (
        <li>
          <a
            href={it.href}
            class:list={[
              'flex items-center justify-center min-h-tap min-w-tap font-mono text-label-caps uppercase',
              active ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {it.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
