---
import "../styles/admissions.css";
const { administrator = false } = Astro.props;
---
<div class="admissions" id="chat-archive" data-administrator={administrator ? "true" : "false"}>
  <p class="eyebrow">{administrator ? "Community administration" : "Members only"}</p>
  <h1>Past Chats</h1>
  <p class="intro">Search conversations from the community’s WhatsApp groups.</p>
  <p class="help">This contains available synced text history, which may be incomplete. Attachments and phone-number metadata are omitted. Historical messages may be outdated.</p>
  <div class="actions"><a href="/apply">Your account</a>{administrator && <a href="/admin">Application dashboard</a>}</div>
  <form id="chat-search">
    <label for="chat-query">Search messages</label><input id="chat-query" name="q" type="search" maxlength="200" placeholder="Try retrieval, voice agents, or evaluation" />
    <label for="chat-group">Group</label><select id="chat-group" name="group"><option value="">All groups</option></select>
    <div class="date-filters"><label for="chat-from">From<input id="chat-from" name="from" type="date" /></label><label for="chat-to">To<input id="chat-to" name="to" type="date" /></label></div>
    <div class="actions"><button class="primary" type="submit">Search chats</button></div>
  </form>
  <p id="chat-status" role="status">Loading archive…</p>
  {administrator && <section><h2>Archive visibility</h2><p>Unpublished groups and hidden messages are unavailable to members and their agents.</p><div id="chat-moderation"></div></section>}
  <div id="chat-results"></div>
  <div class="actions"><button id="chat-more" type="button" hidden>Load more messages</button></div>
  <section id="chat-context" hidden aria-labelledby="chat-context-title"><h2 id="chat-context-title">Conversation context</h2><div id="chat-context-messages"></div></section>
</div>
<style>.date-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.date-filters input{min-width:0}.admissions :global(.chat-text){white-space:pre-wrap;overflow-wrap:anywhere}.admissions :global(.chat-meta){font-size:14px;color:var(--color-on-surface-variant)}</style>
<script>import { initChatArchive } from "../lib/admissions/chats";initChatArchive();</script>
