<section class="routing-review" aria-labelledby="routing-title">
 <div class="routing-heading"><div><p class="eyebrow">Community conversations</p><h2 id="routing-title">Help improve group choices</h2><p>Label the examples that will teach us most about where a post belongs. Clef’s answer appears after yours.</p></div><button id="routing-refresh" type="button">Refresh examples</button></div>
 <p id="routing-status" role="status" aria-live="polite">Loading review examples…</p>
 <div id="routing-metrics" class="routing-metrics"></div>
 <div id="routing-cards" class="routing-grid"></div>
 <details class="routing-controls"><summary>Accuracy, trial and reply controls</summary><div id="routing-results"></div>
 <p>Replies remain paused until a seven-day trial, at least 30 reviewed proposed moves, 95% precision, and one confirmed quoted-reply test are complete.</p>
 <button id="routing-toggle" type="button" disabled>Replies paused</button>
 <form id="routing-test"><h3>One controlled reply test</h3><p>After the trial passes, this sends one signed reply on the next new qualifying post in the selected source group. Historical messages are excluded.</p>
 <label>Reply in this group<select id="routing-test-source"></select></label><label>Suggest this destination<select id="routing-test-destination"></select></label>
 <pre id="routing-test-preview"></pre><button id="routing-test-submit" type="submit" disabled>Request one controlled test</button><button id="routing-test-cancel" type="button" hidden>Cancel pending test</button></form>
 <h3>Reviewed examples and policy</h3><p>Build a candidate prompt from reviewed examples and test it on held-out labels in Cloudflare. Activation pauses replies until another controlled test is confirmed.</p><button id="routing-evaluate" type="button">Evaluate reviewed examples</button><div id="routing-policies"></div><div id="routing-sends"></div></details>
</section>
<style>
 .routing-review{margin-block:3rem;padding-top:2rem;border-top:1px solid var(--border-color,#454545)}
 .routing-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}.routing-heading p{max-width:62ch}.routing-heading button{flex-shrink:0}
 .routing-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}
 .routing-metrics{display:flex;flex-wrap:wrap;gap:.6rem 1.5rem;margin-block:1rem;font-size:.95rem}
 .routing-controls{margin-top:1.5rem;padding:1rem;border:1px solid #454545}.routing-controls summary{cursor:pointer;font-weight:600}.routing-controls form{display:grid;gap:.8rem;max-width:650px;margin-block:1.5rem}.routing-controls select{width:100%;margin-top:.4rem;padding:.7rem;color:inherit;background:#161616;border:1px solid #555}.routing-controls pre{white-space:pre-wrap;font:inherit;padding:1rem;background:#1c1c1c;overflow-wrap:anywhere}
 .routing-review :global(.routing-card){min-width:0;padding:1.25rem;border:1px solid #454545;background:#171717}.routing-review :global(.routing-meta){font-size:.85rem;color:#bdbdbd;margin:0 0 .8rem}.routing-review :global(.routing-text){white-space:pre-wrap;overflow-wrap:anywhere;max-height:22rem;overflow:auto;font-size:1rem;line-height:1.6}.routing-review :global(.routing-context){white-space:pre-wrap;overflow-wrap:anywhere;color:#bdbdbd;font-size:.9rem}.routing-review :global(.routing-choices){display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.routing-review :global(.routing-choices button){padding:.6rem .75rem;min-height:44px}.routing-review :global(textarea){width:100%;min-height:70px;margin-top:.8rem;padding:.6rem;background:#111;color:inherit;border:1px solid #555}.routing-review :global(.routing-feedback){margin-top:.8rem;color:#b9dfbd}.routing-review :global(table){width:100%;border-collapse:collapse;margin-top:1rem;font-size:.9rem}.routing-review :global(th),.routing-review :global(td){padding:.6rem;text-align:left;border-bottom:1px solid #454545}.routing-review :global(.routing-table){overflow-x:auto}.routing-review :global(button:disabled){opacity:.5;cursor:not-allowed}
 @media(max-width:700px){.routing-grid{grid-template-columns:1fr}.routing-heading{display:block}.routing-heading button{margin-top:.6rem}.routing-review :global(.routing-card){padding:1rem}}
</style>
<script>
 type Group={key:string;id:string;title:string};type Card={decisionId:string;messageId:string;groupId:string;text:string;author:string;postedAt:number;historical:boolean;reason:string};
 type Settings={trial_started_at:number;replies_enabled:number;test_verified:number;version:number;test_requested_at:number|null;active_policy:string;policy_requested_at:number|null};
 type Metrics={total:number;reviewedProposals:number;precision:number;trialDays:number;trialPassed:boolean;matrix:Record<string,Record<string,number>>};
 type Send={message_id:string;destination:string;status:string;test:number;whatsapp_message_id:string|null};
 const el=(id:string)=>document.getElementById(id)!;
 let groups:Group[]=[],settings:Settings|null=null,metrics:Metrics|null=null,templates:{choice:string;text:string}[]=[],generation=0;
 async function api<T>(path:string,data?:unknown):Promise<T>{const r=await fetch('/api/admin/chat-routing'+path,{method:data===undefined?'GET':'POST',headers:data===undefined?{}:{'Content-Type':'application/json'},body:data===undefined?undefined:JSON.stringify(data)});const result=await r.json().catch(()=>{throw new Error('The review service is unavailable. Please try again shortly.');});if(!r.ok)throw new Error(result.error?.message??'Could not load routing review.');return result;}
 function node(tag:string,text:string,cls=''){const n=document.createElement(tag);n.textContent=text;if(cls)n.className=cls;return n;}
 function title(key:string){return groups.find(g=>g.key===key)?.title??'Unclear';}
 async function loadMetrics(){const data=await api<{settings:Settings;metrics:Metrics;sends:Send[];policies:{version:string;status:string;evaluation:{cases:number;accuracy:number;precision:number;errors:number};activated_at:number|null}[];replyTemplates:{choice:string;text:string}[]}>('/metrics');settings=data.settings;metrics=data.metrics;templates=data.replyTemplates;
  el('routing-metrics').replaceChildren(node('span',`${data.metrics.total} labeled`),node('span',`${data.metrics.reviewedProposals}/30 proposed moves reviewed`),node('span',`${(data.metrics.precision*100).toFixed(1)}% precision`),node('span',`${Math.min(7,data.metrics.trialDays).toFixed(1)}/7 trial days`));
  const toggle=el('routing-toggle') as HTMLButtonElement;toggle.textContent=settings.replies_enabled?'Pause automatic replies':'Enable automatic replies';toggle.disabled=!settings.replies_enabled&&(!metrics.trialPassed||!settings.test_verified);
  (el('routing-test-submit') as HTMLButtonElement).disabled=!metrics.trialPassed||!!settings.test_requested_at;el('routing-test-cancel').hidden=!settings.test_requested_at;
  const result=el('routing-results');result.replaceChildren(node('p',settings.replies_enabled?'Automatic replies enabled for clear new posts.':'Automatic replies paused. Labeling is improving our examples and evaluation; it does not change Clef’s model weights.'));
  const table=document.createElement('table'),head=document.createElement('tr');head.append(node('th','Your label / Clef choice'),...['general','jobs','demos_events','unclear'].map(k=>node('th',title(k))));table.append(head);for(const key of ['general','jobs','demos_events','unclear']){const row=document.createElement('tr');row.append(node('th',title(key)),...['general','jobs','demos_events','unclear'].map(k=>node('td',String(metrics!.matrix[key]?.[k]??0))));table.append(row);}const wrap=node('div','','routing-table');wrap.append(table);result.append(wrap);
  const sends=el('routing-sends');sends.replaceChildren(node('h3','Recent reply attempts'));if(!data.sends.length)sends.append(node('p','No WhatsApp replies have been attempted.'));for(const s of data.sends){const row=document.createElement('div');row.append(node('p',`${s.test?'Controlled test · ':''}${title(s.destination)} · ${s.status}${s.whatsapp_message_id?' · WhatsApp accepted ID recorded':''}`));if(['uncertain','sending'].includes(s.status)){const form=document.createElement('form');const note=document.createElement('textarea');note.placeholder='Evidence from WhatsApp confirming whether this was sent';note.required=true;note.minLength=10;for(const outcome of ['accepted','not_sent']){const b=node('button',outcome==='accepted'?'Confirm accepted':'Confirm not sent') as HTMLButtonElement;b.type='submit';b.onclick=async e=>{e.preventDefault();if(!note.reportValidity())return;try{await api(`/sends/${s.message_id}/reconcile`,{outcome,reason:note.value});await loadMetrics();}catch(error){el('routing-status').textContent=(error as Error).message;}};form.append(b);}form.prepend(note);row.append(form);}sends.append(row);}
  (el('routing-evaluate') as HTMLButtonElement).disabled=!!settings.policy_requested_at;el('routing-evaluate').textContent=settings.policy_requested_at?'Evaluation queued for cloud sync':'Evaluate reviewed examples';
  const policies=el('routing-policies');policies.replaceChildren(node('p',`Active policy: ${settings.active_policy}`));for(const policy of data.policies){const row=document.createElement('div');row.append(node('p',`${policy.status} · ${policy.evaluation.cases} held-out cases · ${(policy.evaluation.accuracy*100).toFixed(1)}% accuracy · ${(policy.evaluation.precision*100).toFixed(1)}% move precision`));if(policy.status==='ready'&&policy.version!==settings.active_policy){const b=node('button','Activate evaluated policy') as HTMLButtonElement;b.type='button';b.onclick=async()=>{try{await api('/policy/activate',{version:policy.version});await loadMetrics();}catch(error){el('routing-status').textContent=(error as Error).message;}};row.append(b);}policies.append(row);}
  preview();
 }
 function preview(){const source=(el('routing-test-source') as HTMLSelectElement).value,dest=(el('routing-test-destination') as HTMLSelectElement).value;el('routing-test-preview').textContent=`Reply in: ${groups.find(g=>g.id===source)?.title??''}\n\n${templates.find(t=>t.choice===dest)?.text??''}`;}
 async function label(card:Card,value:string,article:HTMLElement,note:HTMLTextAreaElement){const buttons=article.querySelectorAll('button');buttons.forEach(b=>b.disabled=true);try{const result=await api<{modelChoice:string;probabilities:Record<string,number>;holdout:boolean}>('/labels',{decisionId:card.decisionId,label:value,explanation:note.value});article.append(node('p',`You chose ${title(value)}. Clef chose ${title(result.modelChoice)} (${Math.round((result.probabilities[result.modelChoice]??0)*100)}%). ${result.holdout?'Reserved for evaluation.':'Available as a reviewed example.'}`,'routing-feedback'));await loadMetrics();const next=await api<{cards:Card[]}>('/queue');const shown=new Set([...el('routing-cards').querySelectorAll<HTMLElement>('[data-decision]')].map(c=>c.dataset.decision));const fresh=next.cards.find(c=>!shown.has(c.decisionId));if(fresh)el('routing-cards').append(renderCard(fresh));}catch(error){article.append(node('p',(error as Error).message));buttons.forEach(b=>b.disabled=false);}}
 function renderCard(card:Card){const article=node('article','','routing-card');article.dataset.decision=card.decisionId;article.append(node('p',`${groups.find(g=>g.id===card.groupId)?.title??''} · ${new Date(card.postedAt).toLocaleDateString()} · ${card.reason}${card.historical?' · History':''}`,'routing-meta'),node('p',card.text,'routing-text'));
   const context=document.createElement('details');context.append(node('summary','Show nearby messages'));context.addEventListener('toggle',async()=>{if(!context.open||context.dataset.loaded)return;try{const r=await fetch(`/api/admin/chats/messages/${card.messageId}`);if(!r.ok)throw new Error('Context unavailable.');const data=await r.json();context.append(...[...data.before.slice(-2),...data.after.slice(0,2)].map((m:{text:string})=>node('p',m.text,'routing-context')));context.dataset.loaded='true';}catch{context.append(node('p','Context unavailable.'));}});article.append(context);
   const note=document.createElement('textarea');note.maxLength=1500;note.placeholder='Optional: explain the boundary or missing context';note.setAttribute('aria-label','Optional explanation');article.append(note,node('p','Where does this post belong?'));
   const actions=node('div','','routing-choices');for(const key of [...groups.map(g=>g.key),'unclear']){const b=node('button',title(key)) as HTMLButtonElement;b.type='button';b.onclick=()=>label(card,key,article,note);actions.append(b);}article.append(actions);return article;}
 async function load(){const current=++generation;el('routing-status').textContent='Selecting useful examples…';try{const data=await api<{cards:Card[];groups:Group[];available:number}>('/queue');if(current!==generation)return;groups=data.groups;
  for(const id of ['routing-test-source','routing-test-destination']){const select=el(id) as HTMLSelectElement;const previous=select.value;select.replaceChildren(...groups.map(g=>{const option=document.createElement('option');option.value=id.endsWith('source')?g.id:g.key;option.textContent=g.title;return option;}));if(previous)select.value=previous;else if(id.endsWith('destination')&&select.options.length>1)select.selectedIndex=1;}
  const list=el('routing-cards');list.replaceChildren();for(const card of data.cards)list.append(renderCard(card));
  el('routing-status').textContent=data.cards.length?`${data.cards.length} selected examples from ${data.available} awaiting labels. Label these, then refresh for the next batch.`:'No unlabeled examples are ready. New syncs and the historical evaluation will replenish this queue.';await loadMetrics();
 }catch(error){el('routing-status').textContent=(error as Error).message;}}
 el('routing-evaluate').onclick=async()=>{try{await api('/policy/evaluate',{});await loadMetrics();}catch(error){el('routing-status').textContent=(error as Error).message;}};
 el('routing-refresh').onclick=()=>load();el('routing-toggle').onclick=async()=>{if(!settings)return;try{await api('/settings',{enabled:!settings.replies_enabled,version:settings.version});await loadMetrics();}catch(error){el('routing-status').textContent=(error as Error).message;}};
 el('routing-test-source').onchange=preview;el('routing-test-destination').onchange=preview;
 (el('routing-test') as HTMLFormElement).onsubmit=async e=>{e.preventDefault();try{await api('/test',{sourceGroup:(el('routing-test-source') as HTMLSelectElement).value,destination:(el('routing-test-destination') as HTMLSelectElement).value});await loadMetrics();}catch(error){el('routing-status').textContent=(error as Error).message;}};
 el('routing-test-cancel').onclick=async()=>{try{await api('/test',{sourceGroup:(el('routing-test-source') as HTMLSelectElement).value,destination:(el('routing-test-destination') as HTMLSelectElement).value,cancel:true});await loadMetrics();}catch(error){el('routing-status').textContent=(error as Error).message;}};
 load();
</script>
