---
interface Props { sourcePath?: string; }
const { sourcePath } = Astro.props;
const repoUrl = 'https://github.com/NirantK/generativeai-community-site';
const editUrl = sourcePath
  ? `${repoUrl}/edit/main/${sourcePath}`
  : repoUrl;
const year = new Date().getFullYear();
---
<footer class="border-t border-outline-variant mt-stack-lg">
  <div class="mx-auto max-w-3xl px-margin-mobile md:px-margin-desktop py-stack-md flex flex-col md:flex-row items-start md:items-center justify-between gap-stack-sm">
    <span class="font-mono text-label-caps uppercase text-on-surface-variant">
      &copy; {year} GENAI_COMMUNITY
    </span>
    <div class="flex items-center gap-stack-sm flex-wrap">
      <a
        href={editUrl}
        rel="noopener"
        class="font-mono text-label-caps uppercase text-on-surface-variant hover:text-primary inline-flex items-center gap-2 min-h-tap"
        aria-label={sourcePath ? `Edit ${sourcePath} on GitHub` : 'Update this site on GitHub'}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
        </svg>
        <span>UPDATE_ON_GITHUB</span>
      </a>
      <a
        href={repoUrl}
        rel="noopener"
        class="font-mono text-label-caps uppercase text-on-surface-variant hover:text-primary inline-flex items-center gap-2 min-h-tap"
        aria-label="View source on GitHub"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.07c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 015.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
        <span>SOURCE</span>
      </a>
    </div>
  </div>
</footer>
