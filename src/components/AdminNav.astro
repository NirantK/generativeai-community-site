---
interface Props { active: "overview" | "applications" | "message-reviews" | "chats"; }
const { active } = Astro.props;
const links = [
  { key: "overview", label: "Overview", href: "/admin" },
  { key: "applications", label: "Applications", href: "/admin/applications" },
  { key: "message-reviews", label: "Message reviews", href: "/admin/message-reviews" },
  { key: "chats", label: "Past Chats", href: "/admin/chats" },
];
---
<nav aria-label="Administration" class="admin-nav">
  {links.map(link => <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.label}</a>)}
</nav>
<style>
  .admin-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; border-bottom: 1px solid var(--color-outline-variant); padding-bottom: 16px; }
  .admin-nav a { display: inline-flex; align-items: center; min-height: 48px; padding: 10px 14px; text-decoration: none; border: 1px solid transparent; }
  .admin-nav a[aria-current="page"] { border-color: var(--color-outline-variant); background: var(--color-surface-container-high); font-weight: 600; }
  .admin-nav a:hover { background: var(--color-surface-container-high); }
  .admin-nav a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
</style>
