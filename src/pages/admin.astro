---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdminNav from "../components/AdminNav.astro";
import "../styles/admissions.css";
const sections = [
  { title: "Applications", href: "/admin/applications", description: "Review applications and appeals, approve members, and manage administrator invitations." },
  { title: "Message reviews", href: "/admin/message-reviews", description: "Label group choices, track trial accuracy, and manage the agent’s reply controls." },
  { title: "Past Chats", href: "/admin/chats", description: "Search archived conversations and manage published messages." },
];
---
<BaseLayout title="Administration" wide>
  <div class="admissions">
    <AdminNav active="overview" />
    <p class="eyebrow">Community administration</p>
    <h1>Administration</h1>
    <p class="intro">Choose what you’d like to review.</p>
    <div class="admin-sections">
      {sections.map(section => <a class="admin-section" href={section.href}><h2>{section.title}</h2><p>{section.description}</p><span>Open {section.title.toLowerCase()} →</span></a>)}
    </div>
  </div>
</BaseLayout>
<style>
  .admin-sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 20px; margin-top: 32px; }
  .admin-section { display: flex; flex-direction: column; padding: 24px; border: 1px solid var(--color-outline-variant); background: var(--color-surface-container-low); text-decoration: none; }
  .admin-section:hover { background: var(--color-surface-container-high); }
  .admin-section span { margin-top: auto; padding-top: 24px; color: var(--color-primary); font-weight: 600; }
</style>
