---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/admissions.css";
---

<BaseLayout title="Application review" wide>
  <div class="admissions admin-view">
    <p class="eyebrow">Community administration</p>
    <h1>Application review</h1>
    <p>
      Review an applicant’s work and the assessment evidence before deciding.
    </p>
    <p id="admin-message" class="notice" role="status">
      Loading applications…
    </p>
    <div class="actions">
      <button id="reload">Refresh applications</button>
      <a href="/apply">Your account</a>
      <a href="/admin/chats">Manage Past Chats</a>
    </div>
    <section class="application-list" aria-labelledby="list-title">
      <div class="list-toolbar"><div><h2 id="list-title">Approved applications</h2><p class="help">Newest approvals first.</p></div>
        <label for="application-status">Show applications
          <select id="application-status"><option value="approved">Approved</option><option value="review">Needs review</option><option value="submitted">Assessment pending</option><option value="declined">Declined</option><option value="all">All applications</option></select>
        </label>
      </div>
      <div id="applications" class="application-grid"></div>
    </section>
    <section aria-labelledby="administrators-title">
      <h2 id="administrators-title">Administrators</h2>
      <p>Invite someone using their LinkedIn email. They can review applications, make decisions, and invite other administrators after accepting.</p>
      <form id="invite-admin">
        <label for="admin-email">New administrator email</label>
        <input id="admin-email" type="email" required maxlength="254" />
        <button type="submit">Send administrator invitation</button>
      </form>
      <div id="administrators"></div>
    </section>
    <section aria-labelledby="bug-reports-title">
      <h2 id="bug-reports-title">Agent bug reports</h2>
      <div id="bug-reports"></div>
    </section>
    <section id="review" hidden>
      <h2>Review application</h2>
      <div id="record"></div>
      <details>
        <summary>Decision and delivery history</summary>
        <pre id="audit-record"></pre>
      </details>
      <button id="reassess" type="button" hidden>Retry AI assessment</button>
      <form id="decision">
        <label for="reason">Decision reason</label>
        <p class="help">Optional for approval; required to decline.</p>
        <textarea
          id="reason"
          minlength="5"
          maxlength="1500"
        ></textarea>
        <div class="actions">
          <button class="primary" name="action" value="approve">
            Approve
          </button>
          <button name="action" value="decline">
            Decline
          </button>
        </div>
      </form>
      <label for="email-kind">Email to inspect or retry</label>
      <select id="email-kind"><option value="invite">Approval invitation</option><option value="receipt">Submitted application copy</option></select>
      <form id="reconcile" hidden>
        <label for="reconcile-outcome">Cloudflare email log result</label>
        <select id="reconcile-outcome" name="outcome">
          <option value="accepted">Provider accepted this message</option>
          <option value="not_sent">Confirmed not sent</option>
        </select>
        <label for="reconcile-reason">Evidence from the email logs</label>
        <textarea
          id="reconcile-reason"
          name="reason"
          required
          minlength="10"
          maxlength="1500"
        ></textarea>
        <div class="actions">
          <button>Record reconciliation</button>
        </div>
      </form>
      <div class="actions">
        <button id="retry">Retry confirmed failed or paused email</button>
      </div>
      <p class="help">
        For uncertain delivery, inspect Cloudflare email logs first. The
        application will not blindly resend a possibly accepted message.
      </p>
    </section>
  </div>
</BaseLayout>
<script>
  import type { RecordState } from "../../admissions/src/domain";
  const get = (id: string) => document.getElementById(id)!;
  let selected = "";
  let loadGeneration = 0;
  function profileLink(value: string | null | undefined): HTMLElement {
    try {
      const url = new URL(value ?? "");
      if (url.protocol !== "https:" || url.hostname !== "www.linkedin.com" || url.username || url.password || url.port || !/^\/in\/[^/?#]+\/$/.test(url.pathname)) throw new Error();
      const link = document.createElement("a");
      link.href = url.href; link.target = "_blank"; link.rel = "noopener noreferrer";
      link.textContent = "View LinkedIn profile";
      link.title = "Applicant-supplied profile link";
      return link;
    } catch {
      const missing = document.createElement("p"); missing.className = "help";
      missing.textContent = "LinkedIn profile: Not provided";
      return missing;
    }
  }
  async function api<T>(path: string, data?: unknown): Promise<T> {
    const r = await fetch(path, {
      method: data ? "POST" : "GET",
      headers: data ? { "Content-Type": "application/json" } : {},
      body: data ? JSON.stringify(data) : undefined,
    });
    const result = (await r.json()) as T & { error?: { message?: string } };
    if (!r.ok)
      throw new Error(result.error?.message ?? "Could not load applications.");
    return result;
  }
  function message(text: string) {
    get("admin-message").textContent = text;
  }
  let currentRecord: RecordState | null = null;
  function emailControls() {
    if (!currentRecord) return;
    const kind = (get("email-kind") as HTMLSelectElement).value;
    const ledger = kind === "receipt" ? currentRecord.receipt : currentRecord.delivery;
    get("retry").hidden = kind === "invite" ? currentRecord.status !== "approved" : !currentRecord.application;
    get("reconcile").hidden = !["uncertain", "sending"].includes(ledger?.status ?? "pending");
  }
  get("email-kind").onchange = emailControls;
  async function inspect(id: string) {
    selected = id;
    try {
      const record = await api<RecordState>(`/api/admin/applications/${id}`);
      currentRecord = record;
      const container = get("record");
      container.replaceChildren();
      const application = record.application;
      container.append(profileLink(application?.linkedinUrl));
      const fields: [string, string][] = [
        [
          "Applicant",
          `${record.profile?.name ?? ""} · ${record.profile?.email ?? ""}`,
        ],
        ["Submission method", record.submissionChannel ?? "Unknown (legacy application)"],
        ["WhatsApp phone number", application?.whatsapp ?? "Not provided"],
        ["Role", application?.role ?? ""],
        ["AI project or use case", application?.project ?? ""],
        ["Personal contribution", application?.contribution ?? ""],
        ["Reason for joining", application?.motivation ?? ""],
        [
          "Assessment",
          record.assessment?.reasons ??
            "A human review is required; no reliable automated assessment is available.",
        ],
        ["Supporting evidence", record.assessment?.evidence.join("\n\n") ?? ""],
      ];
      for (const [label, value] of fields) {
        const heading = document.createElement("h3");
        heading.textContent = label;
        heading.className = "mt-6 font-semibold";
        const paragraph = document.createElement("p");
        paragraph.textContent = value;
        paragraph.style.whiteSpace = "pre-wrap";
        paragraph.style.overflowWrap = "anywhere";
        container.appendChild(heading);
        container.appendChild(paragraph);
      }
      for (const [index, appeal] of (record.appeals ?? []).entries()) {
        const heading = document.createElement("h3");
        heading.textContent = `Appeal ${index + 1} — ${appeal.resolution ? appeal.resolution.action : "Awaiting decision"}`;
        const evidence = document.createElement("p");
        evidence.style.whiteSpace = "pre-wrap";
        evidence.style.overflowWrap = "anywhere";
        evidence.textContent = `Submitted: ${new Date(appeal.submittedAt).toLocaleString()}\nOriginal rejection: ${appeal.previousDecision.reason}\nWork link: ${appeal.evidence.proofUrl ?? "Not supplied"}\nProject explanation: ${appeal.evidence.explanation ?? "Not supplied"}\nCommunity reference (unverified): ${appeal.evidence.voucher ?? "Not supplied"}\n${appeal.resolution ? "Appeal decision: " + appeal.resolution.reason : "Verify the evidence or reference before deciding."}`;
        container.append(heading, evidence);
      }
      get("audit-record").textContent = JSON.stringify(
        {
          submissionChannel: record.submissionChannel,
          appeals: record.appeals,
          policy: record.policy,
          model: record.model,
          assessmentFailure: record.assessmentFailure,
          assessment: record.assessment,
          decision: record.decision,
          delivery: record.delivery,
          receipt: record.receipt,
          history: record.history,
        },
        null,
        2,
      );
      get("review").hidden = false;
      get("decision").hidden = record.status !== "review";
      get("reassess").hidden = record.status !== "review" || !!record.decision || !!record.appeals?.some(a => !a.resolution);
      emailControls();
      get("review").scrollIntoView({ block: "start" });
    } catch (e) {
      message((e as Error).message);
    }
  }
  async function load() {
    const generation = ++loadGeneration;
    const filter = (get("application-status") as HTMLSelectElement).value;
    get("applications").setAttribute("aria-busy", "true");
    get("applications").replaceChildren();
    message("Loading applications…");
    try {
      const result = await api<{
        applications: {
          id: string;
          name: string;
          status: string;
          delivery: string;
          appeal_status?: string;
          approved_at?: number | null;
          submitted_at?: number | null;
          linkedin_url?: string | null;
        }[];
        indexingRemaining?: number;
      }>(`/api/admin/applications?status=${filter}`);
      if (generation !== loadGeneration) return;
      get("list-title").textContent = ({approved:"Approved applications",review:"Applications needing review",submitted:"Assessment pending",declined:"Declined applications",all:"All applications"} as Record<string,string>)[filter];
      document.querySelector(".list-toolbar .help")!.textContent = filter === "approved" ? "Newest approvals first." : "Newest applications or approvals first.";
      get("applications").replaceChildren();
      for (const a of result.applications) {
        const item = document.createElement("article");
        item.className = "application-card";
        const title = document.createElement("h3");
        title.textContent = a.name;
        const status = document.createElement("p");
        status.textContent = `${a.status}${a.appeal_status === "pending" ? " · APPEAL AWAITING REVIEW" : ""} · Email: ${a.delivery}`;
        const button = document.createElement("button");
        button.textContent = "Review application";
        button.onclick = () => void inspect(a.id);
        item.appendChild(title);
        item.appendChild(status);
        const date = document.createElement("p"); date.className = "help";
        const at = a.status === "approved" ? a.approved_at : a.submitted_at;
        date.textContent = at ? `${a.status === "approved" ? "Approved" : "Applied"} ${new Date(at).toLocaleString(undefined,{dateStyle:"medium",timeStyle:"short"})}` : "Date unavailable";
        item.append(date, profileLink(a.linkedin_url));
        const actions = document.createElement("div"); actions.className = "card-actions"; actions.append(button);
        if (a.status === "review") {
          const approve = document.createElement("button");
          approve.textContent = "Approve now";
          approve.className = "primary";
          approve.onclick = async () => {
            approve.disabled = true;
            try {
              await api(`/api/admin/applications/${a.id}/decision`, { action: "approve" });
              await load();
              if (selected === a.id) await inspect(a.id);
              message("Application approved. Invitation queued for email delivery.");
            } catch (e) { message((e as Error).message); approve.disabled = false; }
          };
          actions.appendChild(approve);
        }
        item.append(actions);
        get("applications").appendChild(item);
      }
      if (!result.applications.length) { const empty = document.createElement("p"); empty.className = "help"; empty.textContent = "No applications in this view."; get("applications").append(empty); }
      get("applications").setAttribute("aria-busy", "false");
      const bugs = await api<{ reports: { id: string; name: string; report: string; created_at: number }[] }>("/api/admin/bug-reports");
      if (generation !== loadGeneration) return;
      get("bug-reports").replaceChildren();
      for (const bug of bugs.reports) {
        const article = document.createElement("article");
        article.className = "review-item";
        const title = document.createElement("h3");
        title.textContent = `${bug.name ?? "Applicant"} · ${new Date(bug.created_at).toLocaleString()}`;
        const content = document.createElement("p");
        content.textContent = bug.report;
        content.style.whiteSpace = "pre-wrap";
        content.style.overflowWrap = "anywhere";
        article.append(title, content);
        get("bug-reports").append(article);
      }
      if (!bugs.reports.length) get("bug-reports").textContent = "No bug reports yet.";
      message(
        result.applications.length
          ? `${result.applications.length} applications shown${result.indexingRemaining ? ". Older approval dates are being restored; refresh to complete." : "."}`
          : "No applications in this view.",
      );
    } catch (e) {
      if (generation === loadGeneration) message((e as Error).message);
    } finally {
      if (generation === loadGeneration) get("applications").setAttribute("aria-busy", "false");
    }
  }
  async function loadAdministrators() {
    try {
      const { invitations } = await api<{invitations: {id:string;email:string;accepted_at:number|null;revoked_at:number|null;expires_at:number;delivery:string}[]}>("/api/admin/invitations");
      get("administrators").replaceChildren();
      for (const invitation of invitations) {
        const row = document.createElement("p");
        const status = invitation.revoked_at ? "Revoked" : invitation.accepted_at ? "Active administrator" : invitation.expires_at < Date.now() ? "Expired" : "Awaiting acceptance";
        row.textContent = `${invitation.email} — ${status} · Email: ${invitation.delivery} `;
        if (!invitation.revoked_at) {
          const revoke = document.createElement("button"); revoke.textContent = "Revoke access";
          revoke.onclick = async () => {
            revoke.disabled = true;
            try {
              const response = await fetch(`/api/admin/invitations/${invitation.id}`, {method:"DELETE"});
              if (!response.ok) throw new Error("Could not revoke access. You cannot revoke your own access.");
              await loadAdministrators();
            } catch(e) { message((e as Error).message); revoke.disabled = false; }
          };
          row.append(revoke);
        }
        get("administrators").append(row);
      }
    } catch(e) { message((e as Error).message); }
  }
  get("invite-admin").addEventListener("submit", async e => {
    e.preventDefault();
    const button = (e.currentTarget as HTMLFormElement).querySelector("button")!;
    button.disabled = true;
    try {
      const result = await api<{delivery:string}>("/api/admin/invitations", {email:(get("admin-email") as HTMLInputElement).value});
      await loadAdministrators();
      message(result.delivery === "accepted" ? "Administrator invitation accepted by the email provider." : "Invitation saved; email outcome needs reconciliation in Cloudflare logs. Do not resend blindly.");
    } catch(e) { message((e as Error).message); }
    finally { button.disabled = false; }
  });
  void loadAdministrators();
  get("application-status").onchange = () => void load();
  get("reload").onclick = () => void load();
  get("decision").addEventListener("submit", async (e) => {
    e.preventDefault();
    const submitter = (e as SubmitEvent).submitter as HTMLButtonElement;
    submitter.disabled = true;
    try {
      await api(`/api/admin/applications/${selected}/decision`, {
        action: submitter.value,
        reason: (get("reason") as HTMLTextAreaElement).value.trim() || undefined,
      });
      await load();
      await inspect(selected);
      message("Decision recorded.");
    } catch (e) {
      message((e as Error).message);
    } finally {
      submitter.disabled = false;
    }
  });
  get("reassess").onclick = async () => {
    const button=get("reassess") as HTMLButtonElement;
    button.disabled=true;
    try { await api(`/api/admin/applications/${selected}/reassess`, {}); await inspect(selected); }
    catch(e) { message((e as Error).message); }
    finally { button.disabled=false; }
  };
  get("retry").onclick = async () => {
    try {
      await api(`/api/admin/applications/${selected}/retry`, {kind:(get("email-kind") as HTMLSelectElement).value});
      await inspect(selected);
    } catch (e) {
      message((e as Error).message);
    }
  };
  get("reconcile").addEventListener("submit", async (e) => {
    e.preventDefault();
    try {
      await api(`/api/admin/applications/${selected}/reconcile`, {
        kind: (get("email-kind") as HTMLSelectElement).value,
        outcome: new FormData(get("reconcile") as HTMLFormElement).get(
          "outcome",
        ),
        reason: new FormData(get("reconcile") as HTMLFormElement).get("reason"),
      });
      await inspect(selected);
      message("Email outcome reconciled.");
    } catch (e) {
      message((e as Error).message);
    }
  });
  void load();
</script>

<style>
  .admin-view > section:not(.application-list) { max-width: 48rem; }
  .list-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 24px; }
  .list-toolbar label { margin-top: 0; width: min(100%, 20rem); }
  .application-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(min(100%,18rem),1fr)); gap: 16px; }
  .application-grid :global(.application-card) { display: flex; flex-direction: column; min-width: 0; padding: 24px; border: 1px solid var(--color-outline-variant); background: var(--color-surface-container-low); overflow-wrap: anywhere; }
  .application-grid :global(h3) { font-size: 24px; line-height: 1.3; font-weight: 600; margin: 0; }
  .application-grid :global(.card-actions) { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 24px; margin-top: auto; }
  .application-grid :global(a) { display: inline-flex; align-items: center; min-height: 48px; }
  .application-grid :global(button:hover:not(:disabled)) { background: var(--color-surface-container-high); }
</style>
