---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import CopyMarkdown from '../components/CopyMarkdown.astro';

const entry = await getEntry('community', 'deephackdemos');
if (!entry) throw new Error('community/deephackdemos content not found');
const { Content } = await render(entry);
const dateStr = entry.data.date ? entry.data.date.toISOString().slice(0, 10) : null;
---
<BaseLayout title={entry.data.title} description={entry.data.description} sourcePath="src/content/community/deephackdemos.md">
  <a
    href="/"
    class="font-mono text-label-caps uppercase text-on-surface-variant hover:text-primary inline-flex items-center gap-2 min-h-tap mt-stack-sm"
  >
    <span aria-hidden="true">&larr;</span> <span>GENAI_COMMUNITY</span>
  </a>

  <section class="mt-stack-sm">
    <span class="font-mono text-label-caps uppercase text-on-surface-variant">// HACKATHON</span>
    <h1 class="mt-stack-sm text-headline-lg-mobile md:text-display-lg font-sans font-bold tracking-tight">
      {entry.data.title}
    </h1>
    {entry.data.description && (
      <p class="mt-stack-sm text-on-surface-variant text-body-base max-w-prose">{entry.data.description}</p>
    )}
    {dateStr && (
      <p class="mt-stack-sm font-mono text-label-caps uppercase text-on-surface-variant">DATE: {dateStr}</p>
    )}
    <div class="mt-stack-md">
      <CopyMarkdown markdown={entry.body ?? ''} filename="deephackdemos.md" />
    </div>
  </section>

  <SectionLabel label="DEMOS" />

  <article class="prose-precision">
    <Content />
  </article>
</BaseLayout>
