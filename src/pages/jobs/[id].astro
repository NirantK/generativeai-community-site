---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { db } from '../../lib/db/client';
import { jobs } from '../../lib/db/schema';
import { and, eq } from 'drizzle-orm';

const { id } = Astro.params;
const [row] = await db(env.DB)
  .select()
  .from(jobs)
  .where(and(eq(jobs.id, id!), eq(jobs.status, 'live')))
  .limit(1);

if (!row) return Astro.redirect('/jobs', 302);

const posted = row.postedAt ? new Date(row.postedAt).toISOString().slice(0, 10) : '';
---
<BaseLayout title={`${row.role} — ${row.company}`} description={row.blurb}>
  <section class="mt-stack-md">
    <span class="font-mono text-label-caps uppercase text-on-surface-variant">// JOB · {posted}</span>
    <h1 class="mt-stack-sm text-headline-lg-mobile md:text-display-lg font-sans font-bold tracking-tight">{row.role}</h1>
    <p class="mt-stack-sm text-title-lg text-on-surface-variant">{row.company} · {row.location}{row.comp ? ` · ${row.comp}` : ''}</p>
    <p class="mt-stack-md text-body-base max-w-prose">{row.blurb}</p>
    <div class="mt-stack-md flex flex-wrap gap-stack-sm">
      <a href={row.applyWeb} rel="noopener" class="inline-flex items-center justify-center min-h-tap px-gutter font-mono text-label-caps uppercase bg-on-surface text-surface hover:opacity-90">APPLY_WEB</a>
      {row.applyApi && (
        <a href={row.applyApi} rel="noopener" class="inline-flex items-center justify-center min-h-tap px-gutter font-mono text-label-caps uppercase border border-outline-variant">APPLY_API</a>
      )}
      <a href={`mailto:${row.contactEmail}`} class="inline-flex items-center justify-center min-h-tap px-gutter font-mono text-label-caps uppercase border border-outline-variant">EMAIL_RECRUITER</a>
    </div>
  </section>
</BaseLayout>
