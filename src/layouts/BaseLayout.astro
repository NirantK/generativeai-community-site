---
import '../styles/global.css';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  sourcePath?: string;
}

const {
  title,
  description = 'Generative AI Community — rules, resources, recommendations, and events for India\'s most active GenAI builders.',
  sourcePath,
} = Astro.props;
const fullTitle = title === 'GenerativeAI Community' ? 'GenerativeAI Community' : `${title} — GenerativeAI Community`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://genaicommunity.ai';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = `${siteUrl}/og.png`;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131313" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="GenerativeAI Community" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-background text-on-surface min-h-screen pb-20 md:pb-0">
    <Header />
    <main class="mx-auto max-w-3xl px-margin-mobile md:px-margin-desktop py-stack-md">
      <slot />
    </main>
    <Footer sourcePath={sourcePath} />
    <BottomNav />
  </body>
</html>
