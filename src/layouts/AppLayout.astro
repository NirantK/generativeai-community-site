---
import BaseLayout from "./BaseLayout.astro";
interface Props {title:string;active:"applications"|"message-review"|"roles"|"search";}
const { title, active } = Astro.props;
const views=[{key:"applications",title:"Applications",admin:true},{key:"message-review",title:"Message Review",admin:true},{key:"roles",title:"Roles",admin:true},{key:"search",title:"Search",admin:false}];
---
<BaseLayout title={title} wide>
 <div class="app-shell">
  <aside><nav aria-label="Workspace"><p class="workspace-title">Community workspace</p>{views.map(view=><a href={`/app/${view.key}`} aria-current={active===view.key?"page":undefined} data-admin-tab={view.admin?"true":undefined} hidden={view.admin&&active==="search"}>{view.title}</a>)}<a href="/apply">Your application &amp; API token</a></nav></aside>
  <div class="app-content"><slot /></div>
 </div>
</BaseLayout>
<style>
 .app-shell{display:grid;grid-template-columns:210px minmax(0,1fr);gap:32px}.app-content{min-width:0}.workspace-title{font-weight:600;padding:12px}.app-shell aside{border-right:1px solid var(--color-outline-variant);padding-right:16px}.app-shell nav{position:sticky;top:24px;display:flex;flex-direction:column;gap:8px}.app-shell nav a{padding:12px;min-height:48px;display:flex;align-items:center;text-decoration:none;border:1px solid transparent}.app-shell nav a[hidden]{display:none}.app-shell nav a[aria-current="page"]{background:var(--color-surface-container-high);border-color:var(--color-outline-variant);font-weight:600}.app-shell nav a:hover{background:var(--color-surface-container-high)}.app-shell nav a:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}
 @media(max-width:760px){.app-shell{grid-template-columns:1fr;gap:8px}.app-shell aside{border-right:0;border-bottom:1px solid var(--color-outline-variant);padding:0 0 16px}.app-shell nav{position:static;flex-direction:row;flex-wrap:wrap;gap:4px}.workspace-title{width:100%;padding:0}.app-shell nav a{padding:10px}}
</style>
<script>
 void(async()=>{try{const response=await fetch("/api/app/access");if(!response.ok)return;const access=await response.json();for(const link of document.querySelectorAll<HTMLElement>("[data-admin-tab]"))link.hidden=!access.administrator;}catch{}})();
</script>
