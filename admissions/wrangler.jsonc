{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "genaicommunity-admissions",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "SITE_URL": "https://genaicommunity.ai",
    "AUTO_APPROVALS_ENABLED": "false",
    "EMAIL_ENABLED": "false",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "LINKEDIN_CLIENT_ID": "78fhwyrcspfuoe"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMISSION",
        "class_name": "AdmissionAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AdmissionAgent"
      ]
    }
  ],
  "workflows": [
    {
      "name": "genaicommunity-admission-review",
      "binding": "REVIEW",
      "class_name": "AdmissionWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "genai_admissions",
      "database_id": "f60fba3c-e5b2-4c5d-9570-17188843e3fa",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@genaicommunity.ai"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "genaicommunity-admissions-staging",
      "vars": {
        "SITE_URL": "https://staging.genaicommunity.ai",
        "AUTO_APPROVALS_ENABLED": "false",
        "EMAIL_ENABLED": "true",
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "LINKEDIN_CLIENT_ID": "78fhwyrcspfuoe"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ADMISSION",
            "class_name": "AdmissionAgent"
          }
        ]
      },
      "workflows": [
        {
          "name": "genaicommunity-admission-review-staging",
          "binding": "REVIEW",
          "class_name": "AdmissionWorkflow"
        }
      ],
      "d1_databases": [
        {
          "binding": "INDEX",
          "database_name": "genai_admissions_staging",
          "database_id": "ef73a125-5c4d-4026-95be-2dd688b58a99",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "noreply@genaicommunity.ai"
          ]
        }
      ]
    }
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "account_id": "076c525b59739562570401e48fc0651c"
}
