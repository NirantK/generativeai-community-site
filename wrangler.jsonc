{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "generativeai-community-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-16",
  "services": [
    {
      "binding": "ADMISSIONS",
      "service": "genaicommunity-admissions",
      "entrypoint": "AdmissionsGateway"
    }
  ],
  "env": {
    "preview": {
      "services": [
        {
          "binding": "ADMISSIONS",
          "service": "genaicommunity-admissions-staging",
          "entrypoint": "AdmissionsGateway"
        }
      ]
    }
  }
}
